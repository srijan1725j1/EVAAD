# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Google AdSense Configuration (Client-side):
# Set your AdSense Publisher ID (e.g., ca-pub-8666838424059257) and ad unit slot IDs
# once your domain is approved in Google AdSense. When unset, evaad automatically
# falls back to native topic-matched Sponsored Cards.
VITE_ADSENSE_CLIENT_ID="ca-pub-8666838424059257"
VITE_ADSENSE_INFEED_SLOT=""
VITE_ADSENSE_SIDEBAR_SLOT=""

# Contact & Publisher Disclosure Configuration (Client-side):
# Required for the /contact and /privacy pages so users and reviewers can reach you.
VITE_CONTACT_EMAIL=""
VITE_LEGAL_ENTITY_NAME=""
VITE_LEGAL_JURISDICTION=""
VITE_ADMIN_EMAIL="chandra.oms@gmail.com"

# Optional Immediate Affiliate / Referral Link Overrides (Client-side):
# Set any of these to your own referral/affiliate links (e.g. Amazon Associates, Coursera,
# Notion, Substack, or direct sponsor URLs) to earn commissions immediately while AdSense review is pending.
VITE_AFFILIATE_DEFAULT_URL=""
VITE_AFFILIATE_TECH_URL=""
VITE_AFFILIATE_ECONOMY_URL=""
VITE_AFFILIATE_WORK_URL=""
VITE_AFFILIATE_EDUCATION_URL=""
VITE_AFFILIATE_SPORTS_URL=""
VITE_AFFILIATE_POLITICS_URL=""
